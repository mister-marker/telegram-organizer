# Скопируйте этот файл в .env и заполните своими значениями.
# api_id и api_hash получаются на https://my.telegram.org -> API development tools
# Это данные ВАШЕГО приложения (не пароль от аккаунта), но их всё равно нельзя
# публиковать или коммитить в git.
TG_API_ID=
TG_API_HASH=

# Имя аккаунта в macOS Keychain для хранения Telethon StringSession
TG_SESSION_NAME=tg_organizer

# Через сколько дней без сообщений диалог считается "мёртвым"
DEAD_AFTER_DAYS=180

# Device fingerprint для MTProto initConnection.
# Обычно можно оставить пустым: модель Mac и версия macOS определятся автоматически.
# Override нужен только если вы осознанно хотите другой отпечаток.
# TG_DEVICE_MODEL=MacBook Pro
# TG_SYSTEM_VERSION=macOS 15.6
TG_APP_VERSION=5.16.4
TG_LANG_CODE=en
TG_SYSTEM_LANG_CODE=en
