# Скопируйте этот файл в .env и заполните своими значениями.
# api_id и api_hash получаются на https://my.telegram.org -> API development tools
# Это данные ВАШЕГО приложения (не пароль от аккаунта), но их всё равно нельзя
# публиковать или коммитить в git.
TG_API_ID=
TG_API_HASH=

# Имя файла сессии (создастся автоматически при первом запуске)
TG_SESSION_NAME=tg_organizer

# Через сколько дней без сообщений диалог считается "мёртвым"
DEAD_AFTER_DAYS=180
